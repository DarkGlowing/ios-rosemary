+/* Write the whole ring to the device now.
+ *
+ * The flusher sleeps for up to ufslogsecs between writes, and panic() never
+ * returns to let it wake up, so without this the last screenful -- the panic
+ * reason and the driver messages right before it -- stays in DRAM and the
+ * pulled log ends before the interesting part. Called from the panic path on
+ * this CPU only: no allocation, no new thread. The lock is tried, not taken:
+ * if the flusher thread is inside a command we must not wait for it, since
+ * it never runs again. */
+void
+rosemary_log_panic_flush(void)
+{
+	if (!su.ready || !su.writable) {
+		return;
+	}
+	if (!lck_mtx_try_lock(&rosemary_ufs_lock)) {
+		return;
+	}
+	uint64_t base = su.first_block + su.nblocks - ROSEMARY_LOG_BLOCKS;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	uint64_t total = os_atomic_load(&rosemary_log_total, relaxed);
+	uint32_t blocks = ROSEMARY_LOG_SIZE / UFS_BLOCK;
+	int error = 0;
+
+	/* A reader starts at ring byte 0 and follows total % size, so writing
+	 * the untouched tail of a ring that never filled wastes only the write
+	 * of a few blocks; skip them instead. */
+	if (total < ROSEMARY_LOG_SIZE) {
+		blocks = (uint32_t)((total + UFS_BLOCK - 1) / UFS_BLOCK);
+	}
+	for (uint32_t blk = 0; blk < blocks && !error; blk += (uint32_t)(BOUNCE_SIZE / UFS_BLOCK)) {
+		uint32_t n = MIN((uint32_t)(BOUNCE_SIZE / UFS_BLOCK), blocks - blk);
+		memcpy(bounce, rosemary_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_write_blocks(base + 1 + blk, n);
+	}
+	if (!error) {
+		struct rosemary_log_header h = {
+			.magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+			.version = 1, .size = ROSEMARY_LOG_SIZE, .total = total, .seq = 0,
+		};
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &h, sizeof(h));
+		error = ufs_write_blocks(base, 1);
+	}
+	if (!error) {
+		(void)ufs_sync_cache();
+	}
+	lck_mtx_unlock(&rosemary_ufs_lock);
+}
