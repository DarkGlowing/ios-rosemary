+/*
+ * rosemary (Redmi Note 10S / MT6785) power/volume keys + battery power source.
+ *
+ * Replaces the sweet Qualcomm SPMI/PM6150 driver. On rosemary the PMIC is
+ * MT6359 behind pwrap@1000d000 (see rosemary_spmi.c). Minimal polled driver:
+ * one thread, ~16 ms poll, HID consumer-key events via rosemary_hid_key().
+ *
+ * Power key : MT6359 TOPSTATUS (0x0a08) bit 3 (KPWR, active low = pressed).
+ * Volume +/-: MT6359 KPD (keypad matrix). On rosemary they are on KPD rows;
+ *             read KPC_GP status (0x090a). If volume does not fire, check
+ *             /proc/device-tree/mt6359/kpd or gpio-keys and adjust KPD_REG.
+ * Battery   : IOPMPowerSource; voltage from MT6359 AUXADC channel 15 (VBAT)
+ *             when rosemarybattery=1, otherwise static 100 % (boots fine).
+ *
+ * HID consumer-page usages (iOS): Power=0x30, VolUp=0xE9, VolDown=0xEA.
+ */
+#include <stdint.h>
+#include <kern/thread.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "rosemary_spmi.h"
+
+extern void rosemary_hid_key(int key, int down);
+extern kern_return_t thread_terminate(thread_t);
+
+/* MT6359 registers (slave 0, via pwrap) */
+#define MT6359_TOPSTATUS	0x0a08	/* KPWR bit = bit3 (0 = pressed) */
+#define MT6359_KPD_GP		0x090a	/* KPD key-pressed status (16 bits); verify */
+#define  KPWR_BIT		(1u << 3)
+#define  KPD_VOLUP_BIT		(1u << 0)	/* adjust after probing KPD matrix */
+#define  KPD_VOLDN_BIT		(1u << 1)
+
+#define KEY_POWER	0x30
+#define KEY_VOLUP	0xe9
+#define KEY_VOLDN	0xea
+
+static int enabled = 1;
+static int real_battery;
+
+static uint16_t pmic_rd(unsigned reg) { return rosemary_pwrap_read16(reg); }
+
+static void keys_thread(void *arg, wait_result_t result)
+{
+	(void)arg; (void)result;
+	int last[3] = {0, 0, 0};	/* power, volup, voldown */
+	for (;;) {
+		uint16_t top = pmic_rd(MT6359_TOPSTATUS);
+		uint16_t kpd = pmic_rd(MT6359_KPD_GP);
+		int power = !(top & KPWR_BIT);		/* active low */
+		int volup = !!(kpd & KPD_VOLUP_BIT);
+		int voldn = !!(kpd & KPD_VOLDN_BIT);
+		int state[3] = { power, volup, voldn };
+		int keycode[3] = { KEY_POWER, KEY_VOLUP, KEY_VOLDN };
+		for (int k = 0; k < 3; k++)
+			if (state[k] != last[k]) {
+				rosemary_hid_key(keycode[k], state[k]);
+				last[k] = state[k];
+			}
+		delay(16);	/* ~60 Hz poll */
+	}
+}
+
+/* Battery: called periodically by the power-source nub. Returns mV. */
+unsigned rosemary_battery_mv(void);	/* in rosemary_spmi.c (AUXADC) */
+
+void rosemary_keys_init(void)
+{
+	(void)PE_parse_boot_argn("rosemarykeys", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("rosemarybattery", &real_battery, sizeof(real_battery));
+	if (!enabled) {
+		printf("ROSEMARY KEYS: disabled (rosemarykeys=0)\n");
+		return;
+	}
+	if (rosemary_spmi_init()) {
+		printf("ROSEMARY KEYS: pwrap init failed, keys disabled\n");
+		return;
+	}
+	uint16_t top = pmic_rd(MT6359_TOPSTATUS);
+	printf("ROSEMARY KEYS: MT6359 pwrap OK, TOPSTATUS=%#x (KPWR %s)\n",
+	       top, (top & KPWR_BIT) ? "released" : "pressed");
+	thread_t thread;
+	kern_return_t kr = kernel_thread_start((thread_continue_t)keys_thread, NULL, &thread);
+	if (kr != KERN_SUCCESS) {
+		printf("ROSEMARY KEYS: kernel_thread_start failed %d\n", kr);
+		return;
+	}
+	thread_deallocate(thread);
+	printf("ROSEMARY KEYS: polling thread started (power via PON, volume via KPD 0x090a)\n");
+}
--- /dev/null
+++ b/bsd/dev/rosemary_touch.c
@@ -0,0 +1,181 @@
+/*
+ * rosemary (Redmi Note 10S / MT6785) touchscreen driver.
+ *
+ * Touch controller: Goodix GT9896 @ I2C 0x5d (confirmed in rosemary dmesg:
+ * irq/28-goodix_f, "gf" firmware). The Goodix report protocol is IDENTICAL to
+ * sweet's (status 0x4180, report 0x4188, product-id 0x4022, ack = write 0 to
+ * 0x4180) -- only the I2C transport changes: Qualcomm GENI QUP -> MediaTek
+ * i2c-mt65xx PIO controller.
+ *
+ * Touch I2C bus: verify with `ls /proc/device-tree/i2c@*/touch*`. On rosemary
+ * the Goodix is typically on i2c0@11007000 (goodix@5d, confirmed by rosemary dump). If probe fails, change TOUCH_I2C_BASE.
+ *
+ * Polled (no EINT routing needed). Boot-args: rosemarytouch=0 to disable,
+ * rosemarytouchdelay=N (seconds before probe), rosemarytouchirq (unused, kept).
+ */
+#include <stdint.h>
+#include <kern/thread.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern void rosemary_hid_touch(int finger, int down, int x, int y);
+extern kern_return_t thread_terminate(thread_t);
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define TOUCH_I2C_BASE	0x11007000UL	/* i2c0@11007000 (goodix@5d, confirmed by rosemary dump); VERIFY (touch node interrupt-parent) */
+#define GOODIX_ADDR	0x5d
+#define GOODIX_MAX_FINGERS 5
+
+/* MediaTek i2c-mt65xx registers (PIO mode) */
+#define I2C_DATA_PORT	0x00
+#define I2C_SLAVE_ADDR	0x04
+#define I2C_INTR_MASK	0x08
+#define I2C_INTR_STAT	0x0c
+#define I2C_CONTROL	0x10
+#define I2C_TRANSFER_LEN 0x14
+#define I2C_TRANSAC_LEN 0x18
+#define I2C_DELAY_LEN	0x1c
+#define I2C_TIMING	0x20
+#define I2C_START	0x24
+#define I2C_FIFO_STAT	0x30
+#define I2C_SOFTRESET	0x44
+
+#define CONTROL_IO_MODE		(1u << 7)	/* PIO (not DMA) */
+#define CONTROL_DIR_CHANGE	(1u << 4)	/* repeated-start read */
+#define CONTROL_ACKERR_DET	(1u << 5)
+#define CONTROL_TRANS_LEN_VLD	(1u << 0)
+#define CONTROL_TRANSAC_VLD	(1u << 1)
+#define CONTROL_CLK_DIV_VLD	(1u << 3)
+#define CONTROL_STOP_FLAG	(1u << 11)
+#define INTR_MASTER_DONE	(1u << 4)
+#define INTR_ACK		(1u << 0)
+
+static volatile uint8_t *i2c_base;
+
+static inline uint32_t i2c_rd(unsigned o) { return *(volatile uint32_t *)(i2c_base + o); }
+static inline void     i2c_wr(unsigned o, uint32_t v) { *(volatile uint32_t *)(i2c_base + o) = v; }
+
+static void udelay(unsigned us) {
+	uint64_t end; __asm__ volatile("isb; mrs %0, cntvct_el0" : "=r"(end));
+	end += 13000000ULL / 1000000 * us;
+	uint64_t n; do { __asm__ volatile("isb; mrs %0, cntvct_el0" : "=r"(n)); } while (n < end);
+}
+
+/* One I2C transfer: write tx[] (len txlen), optionally restart and read rxlen bytes.
+ * Returns 0 on success. Polled PIO. */
+static int touch_msg(uint8_t addr, const uint8_t *tx, unsigned txlen,
+		     uint8_t *rx, unsigned rxlen, int hold)
+{
+	(void)hold;
+	i2c_wr(I2C_SOFTRESET, 1);
+	udelay(20);
+	i2c_wr(I2C_SLAVE_ADDR, addr << 1);
+	i2c_wr(I2C_INTR_MASK, 0);		/* poll */
+	i2c_wr(I2C_TIMING, 0x0004);		/* ~100 kHz; increase for 400 kHz */
+	i2c_wr(I2C_DELAY_LEN, 0);
+	/* fill TX FIFO with register address / write data */
+	for (unsigned i = 0; i < txlen; i++)
+		i2c_wr(I2C_DATA_PORT, tx[i]);
+	unsigned total = txlen + rxlen;
+	i2c_wr(I2C_TRANSFER_LEN, total);
+	i2c_wr(I2C_TRANSAC_LEN, rxlen ? 2 : 1);
+	uint32_t ctrl = CONTROL_IO_MODE | CONTROL_ACKERR_DET | CONTROL_TRANS_LEN_VLD |
+			CONTROL_TRANSAC_VLD | CONTROL_CLK_DIV_VLD | CONTROL_STOP_FLAG;
+	if (rxlen) ctrl |= CONTROL_DIR_CHANGE;	/* write reg, restart, read */
+	i2c_wr(I2C_CONTROL, ctrl);
+	i2c_wr(I2C_START, 1);
+	for (int i = 0; i < 50000; i++) {
+		udelay(10);
+		uint32_t st = i2c_rd(I2C_INTR_STAT);
+		if (st & INTR_ACK) return -1;	/* NACK */
+		if (st & INTR_MASTER_DONE) break;
+	}
+	if (!(i2c_rd(I2C_INTR_STAT) & INTR_MASTER_DONE))
+		return -2;			/* timeout */
+	if (rxlen) {
+		uint32_t fs = i2c_rd(I2C_FIFO_STAT);
+		unsigned rxcount = (fs >> 8) & 0xff;	/* RX FIFO count (verify shift) */
+		if (rxcount > rxlen) rxcount = rxlen;
+		for (unsigned i = 0; i < rxcount; i++)
+			rx[i] = (uint8_t)i2c_rd(I2C_DATA_PORT);
+	}
+	i2c_wr(I2C_INTR_STAT, 0xffffffff);	/* clear */
+	return 0;
+}
+
+static int touch_read(uint8_t addr, uint16_t reg, int stop, uint8_t *buf, unsigned len)
+{
+	(void)stop;
+	uint8_t tx[2] = { (uint8_t)(reg >> 8), (uint8_t)reg };
+	return touch_msg(addr, tx, 2, buf, len, 0);
+}
+static int touch_wr(uint16_t reg, uint8_t val)
+{
+	uint8_t tx[3] = { (uint8_t)(reg >> 8), (uint8_t)reg, val };
+	return touch_msg(GOODIX_ADDR, tx, 3, NULL, 0, 0);
+}
+
+#define GOODIX_STATUS	0x4180
+#define GOODIX_REPORT	0x4188
+#define GOODIX_PID	0x4022
+
+static int enabled = 1, delay_s;
+
+static void touch_thread(void *arg, wait_result_t result)
+{
+	(void)arg; (void)result;
+	if (delay_s) delay(delay_s * 1000);
+	uint8_t gid[6] = {0};
+	int ge = touch_read(GOODIX_ADDR, GOODIX_PID, 1, gid, sizeof(gid));
+	printf("ROSEMARY TOUCH: GT9896 @0x5d on i2c@%lx probe err=%d pid=%02x%02x%02x%02x\n",
+	       (unsigned long)TOUCH_I2C_BASE, ge, gid[0], gid[1], gid[2], gid[3]);
+	int last_down[GOODIX_MAX_FINGERS] = {0};
+	int lx[GOODIX_MAX_FINGERS], ly[GOODIX_MAX_FINGERS];
+	for (;;) {
+		uint8_t st[8] = {0};
+		if (touch_read(GOODIX_ADDR, GOODIX_STATUS, 1, st, 1) || !(st[0] & 0x80)) {
+			delay(8);
+			continue;
+		}
+		uint8_t buf[42] = {0};
+		touch_read(GOODIX_ADDR, GOODIX_STATUS, 1, buf, sizeof(buf));
+		unsigned nf = buf[0] & 0x0f;
+		if (nf > GOODIX_MAX_FINGERS) nf = GOODIX_MAX_FINGERS;
+		for (unsigned f = 0; f < GOODIX_MAX_FINGERS; f++) {
+			int down = f < nf;
+			int x = 0, y = 0;
+			if (down) {
+				unsigned o = 8 + f * 8;
+				x = buf[o+1] << 8 | buf[o];
+				y = buf[o+3] << 8 | buf[o+2];
+				x = x * 1125 / 1080;	/* scale to iPhone X 1125x2436 */
+				y = y * 2436 / 2400;
+				lx[f] = x; ly[f] = y;
+			} else { x = lx[f]; y = ly[f]; }
+			if (down != last_down[f]) {
+				rosemary_hid_touch(f, down, x, y);
+				last_down[f] = down;
+			}
+		}
+		touch_wr(GOODIX_STATUS, 0);	/* ack: clear status */
+		delay(8);
+	}
+}
+
+void rosemary_touch_init(void)
+{
+	(void)PE_parse_boot_argn("rosemarytouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("rosemarytouchdelay", &delay_s, sizeof(delay_s));
+	if (!enabled) { printf("ROSEMARY TOUCH: disabled (rosemarytouch=0)\n"); return; }
+	i2c_base = (volatile uint8_t *)ml_io_map((vm_offset_t)TOUCH_I2C_BASE, 0x1000);
+	if (!i2c_base) { printf("ROSEMARY TOUCH: i2c map failed\n"); return; }
+	thread_t th;
+	if (kernel_thread_start((thread_continue_t)touch_thread, NULL, &th) != KERN_SUCCESS) {
+		printf("ROSEMARY TOUCH: thread start failed\n"); return;
+	}
+	thread_deallocate(th);
+}
