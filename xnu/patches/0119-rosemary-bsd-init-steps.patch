--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -495,7 +495,17 @@
 #define DEBUG_BSDINIT 1
 
 #if DEBUG_BSDINIT
+#if defined(ARM64_BOARD_CONFIG_ROSEMARY)
+/*
+ * kprintf does not reach the console ring on this board, so the "calling
+ * <step>" lines never showed up and a stop inside bsd_init was invisible.
+ * printf is the path the heartbeat and the ROSEMARY BSD markers use, and
+ * those do reach the ring and the disk.
+ */
+#define bsd_init_kprintf(x, ...) printf("bsd_init: " x, ## __VA_ARGS__)
+#else
 #define bsd_init_kprintf(x, ...) kprintf("bsd_init: " x, ## __VA_ARGS__)
+#endif
 #else
 #define bsd_init_kprintf(x, ...)
 #endif
