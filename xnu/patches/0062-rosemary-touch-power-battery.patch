+/*
+ * rosemary (Redmi Note 10S / MT6785) regulator/touch-rail enable.
+ *
+ * Replaces the sweet Qualcomm RPMh driver. On rosemary there is no RPMh:
+ * regulators are MT6359 LDOs programmed through pwrap. The touchscreen's
+ * vtouch-supply is already enabled by lk (the touch works in Android/fastboot),
+ * so for bring-up this is a no-op success. If you need to gate the rail:
+ *   - read /proc/device-tree/touch/vtouch-supply phandle -> which LDO
+ *   - MT6359 LDOx_CON0 (enable) / LDOx_CON1 (voltage) at the offset in the
+ *     MT6359 datasheet, written with rosemary_pwrap_write16() from rosemary_spmi.c
+ *
+ * `res` and `mv` are accepted for API compatibility; `res` is logged.
+ */
+#include <stdint.h>
+#include <sys/systm.h>
+
+int rosemary_rpmh_vreg_enable(const char *res, unsigned mv)
+{
+	/* Touch rail is left on by lk; nothing to do. Log once. */
+	static int once;
+	if (!once) {
+		printf("ROSEMARY VREG: '%s' %u mV: assumed already enabled by lk (no RPMh on MT6785)\n",
+		       res ? res : "(null)", mv);
+		once = 1;
+	}
+	return 0;
+}
--- /dev/null
+++ b/bsd/dev/rosemary_spmi.c
@@ -0,0 +1,121 @@
+/*
+ * rosemary (Redmi Note 10S / MT6785 Helio G95) PMIC access over pwrap.
+ *
+ * Replaces the sweet Qualcomm SPMI driver. On rosemary the PMIC is MT6359,
+ * reached through the MediaTek PMIC wrapper (pwrap@1000d000). We use WACS2
+ * (the non-secure / world-shareable command channel); lk leaves pwrap clocks
+ * and the WACS2 FSM running, so no full re-init is needed -- we only issue
+ * read/write commands and poll for completion.
+ *
+ * Register interface (MT6785 pwrap, mainline drivers/soc/mediatek/mtk-pmic-wrap.c):
+ *   WACS2_CMD   = base + 0x3c0   [31] WRT (1=write,0=read) [30:16] ADDR [15:0] WDATA
+ *   WACS2_RDATA = base + 0x3c4   [15:0] RDATA  (read result; VLD bit is SoC-specific,
+ *                                              we poll by FSM/timeout instead)
+ *   ADDR encoding = (slave_id << 8) | reg_addr; MT6359 slave_id = 0.
+ *
+ * Battery fuel-gauge (MT6359 FG) and AUXADC live in the same register space.
+ */
+#include <stdint.h>
+#include <kern/thread.h>
+#include <vm/vm_map.h>
+#include "rosemary_spmi.h"
+
+#define PWRAP_BASE	0x1000d000UL	/* pwrap@1000d000 (rosemary live FDT) */
+#define WACS2_CMD	0x3c0
+#define WACS2_RDATA	0x3c4
+
+#define WACS_WRT	(1U << 31)
+#define WACS_ADDR(reg)	(((reg) & 0xffff) << 16)	/* slave 0 */
+
+static volatile uint8_t *pwrap_base;
+
+static inline uint32_t pw_rd(unsigned off)  { return *(volatile uint32_t *)(pwrap_base + off); }
+static inline void     pw_wr(unsigned off, uint32_t v) { *(volatile uint32_t *)(pwrap_base + off) = v; }
+
+static void udelay(unsigned us)
+{
+	/* busy-wait on the virtual counter; CNTFRQ is ~13 MHz on MT6785 */
+	uint64_t f = 13000000ULL;
+	uint64_t end;
+	__asm__ volatile("isb; mrs %0, cntvct_el0" : "=r"(end));
+	end += f / 1000000 * us;
+	uint64_t now;
+	do { __asm__ volatile("isb; mrs %0, cntvct_el0" : "=r"(now)); } while (now < end);
+}
+
+int rosemary_spmi_init(void)
+{
+	extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+	pwrap_base = (volatile uint8_t *)ml_io_map((vm_offset_t)PWRAP_BASE, 0x1000);
+	if (!pwrap_base)
+		return -1;
+	/* WACS2 is left configured by lk; just flush any stale read. */
+	(void)pw_rd(WACS2_RDATA);
+	return 0;
+}
+
+uint16_t rosemary_pwrap_read16(unsigned addr)
+{
+	if (!pwrap_base)
+		return 0;
+	/* Issue read: WRT=0, ADDR=(slv<<8|reg). Then poll for the result. */
+	pw_wr(WACS2_CMD, WACS_ADDR(addr));
+	for (int i = 0; i < 1000; i++) {
+		udelay(1);
+		uint32_t r = pw_rd(WACS2_RDATA);
+		/* On MT6785 WACS2_RDATA returns the last read value once the
+		 * FSM completes; a second read of CMD is harmless. We accept
+		 * after a fixed small delay (lk uses the same ~1 us timeout). */
+		if (i > 2)
+			return (uint16_t)(r & 0xffff);
+	}
+	return (uint16_t)(pw_rd(WACS2_RDATA) & 0xffff);
+}
+
+int rosemary_pwrap_write16(unsigned addr, uint16_t val)
+{
+	if (!pwrap_base)
+		return -1;
+	pw_wr(WACS2_CMD, WACS_WRT | WACS_ADDR(addr) | (val & 0xffff));
+	udelay(5);
+	return 0;
+}
+
+int rosemary_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
+{
+	(void)sid;	/* MT6359 is slave 0 */
+	uint16_t v = rosemary_pwrap_read16(addr);
+	if (out) {
+		out[0] = (uint8_t)(v & 0xff);
+		out[1] = (uint8_t)(v >> 8);
+	}
+	return 0;
+}
+
+/* ---- MT6359 AUXADC: battery voltage (channel 15 = VBAT) ----
+ * MT6359 AUXADC registers (mainline mt6359-auxadc):
+ *   CON0   = 0x0c00  (bit0 = channel 0 ... bit15 = channel 15; write to start)
+ *   CON1   = 0x0c02  (same mask, "immediate" mode)
+ *   STATUS = 0x0c06  (bit0 = busy)
+ *   DATA15 = 0x0c26? (per-channel data, 2 bytes each: DATA0=0x0c08, DATA1=0x0c0a ...)
+ * Voltage = raw * 3 / 4096 * (1/3)?? VBAT is divided by 1/3: Vbat = raw*15000/4096 mV?
+ *   MT6359 VBAT channel has 1/3 divider: Vbat_mV = raw * 15000 / 4096.
+ */
+#define AUXADC_CON1	0x0c02
+#define AUXADC_STATUS	0x0c06
+#define AUXADC_DATA15	0x0c26	/* channel 15 (VBAT) data register; verify in mt6359 datasheet */
+
+unsigned rosemary_battery_mv(void)
+{
+	rosemary_pwrap_write16(AUXADC_CON1, 1u << 15);	/* start channel 15 */
+	for (int i = 0; i < 2000; i++) {
+		udelay(10);
+		if (!(rosemary_pwrap_read16(AUXADC_STATUS) & 1))
+			break;
+	}
+	uint16_t raw = rosemary_pwrap_read16(AUXADC_DATA15) & 0x0fff;
+	/* VBAT divider 1/3, reference 1.2 V? MT6359 auxadc full-scale ~1.5V*? 
+	 * Conservative: Vbat_mV = raw * 15000 / 4096. If readings are off by
+	 * exactly 3x, adjust the divisor here. */
+	return (unsigned)raw * 15000U / 4096U;
+}
--- /dev/null
+++ b/bsd/dev/rosemary_spmi.h
@@ -0,0 +1,37 @@
+/*
+ * rosemary (Redmi Note 10S / MT6785) PMIC access shim.
+ *
+ * Historical name kept for ABI compatibility with the rest of the port
+ * (Makefiles and callers reference rosemary_spmi_*). On rosemary there is no
+ * SPMI bus: the PMIC (MT6359) sits behind the MediaTek PMIC wrapper (pwrap)
+ * at 0x1000d000. This file exposes the same read interface, implemented over
+ * pwrap WACS2 (non-secure world channel).
+ *
+ * MT6359 slave id = 0. MT6360 (charger/LED, secondary) is not used here.
+ */
+#ifndef ROSEMARY_SPMI_H
+#define ROSEMARY_SPMI_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Initialize pwrap (leave clocks as the bootloader set them). Returns 0 on success. */
+int rosemary_spmi_init(void);
+
+/* Read one 16-bit PMIC register. `sid` is ignored (MT6359 = slave 0); kept for API compat. */
+int rosemary_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+
+/* Write one 16-bit PMIC register (added for rosemary; sweet only had read). */
+int rosemary_pwrap_write16(unsigned addr, uint16_t val);
+
+/* Read one 16-bit PMIC register directly. */
+uint16_t rosemary_pwrap_read16(unsigned addr);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ROSEMARY_SPMI_H */
