--- a/osfmk/arm/machine_routines_common.c
+++ b/osfmk/arm/machine_routines_common.c
@@ -1284,6 +1284,19 @@
 ml_wait_max_cpus(void)
 {
 	assert(lockdown_done);
+#if defined(ARM64_BOARD_CONFIG_ROSEMARY)
+	/*
+	 * This wait is for a CPU driver that calls ml_set_max_cpus(). The only
+	 * one here is RosemaryCPU, whose IONameMatch is 'qcom,kryo470' -- a
+	 * Qualcomm node that does not exist in the MediaTek device tree -- so it
+	 * never starts and the counter is never published. The value we would
+	 * return is already known from the device tree (pe_identify_machine),
+	 * so return it now instead of sleeping forever. This is what stopped
+	 * bsd_init right after "calling proc_uuid_policy_init()":
+	 * mcache_init() calls this and mcache_init() is the next step.
+	 */
+	return machine_info.max_cpus;
+#else
 	lck_mtx_lock(&max_cpus_lock);
 	while (max_cpus_initialized != MAX_CPUS_SET) {
 		max_cpus_initialized = MAX_CPUS_WAIT;
@@ -1291,6 +1304,7 @@
 	}
 	lck_mtx_unlock(&max_cpus_lock);
 	return machine_info.max_cpus;
+#endif
 }
 
 void
