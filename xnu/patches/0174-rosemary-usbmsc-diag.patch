 static void usbmsc_strategy(struct buf *bp) {
  uint64_t bytes=buf_count(bp);daddr64_t block=buf_blkno(bp);int err=0;
+#if defined(ROSEMARY)
+ /* The exec of /sbin/launchd fails with EINVAL and none of the kernel-side
+  * checks is responsible, so the file read path is the remaining suspect.
+  * Log the shape of every request that fails, which says whether the vnode
+  * layer is asking for something this driver refuses.
+  */
+ uint64_t d_bytes=bytes; daddr64_t d_block=block; uint32_t d_flags=buf_flags(bp);
+#endif
  buf_setresid(bp,buf_count(bp));
  lck_mtx_lock(&usbmsc_lock);
  if(!sc.ready||sc.failed){err=ENXIO;goto out;}
@@ -715,9 +723,21 @@
   data+=n;lba+=n/512;bytes-=n;buf_setresid(bp,(int)bytes);
  }
 out:
+#if defined(ROSEMARY)
+ if(err) {
+  printf("ROSEMARY USBMSC: error=%d blk=%lld bytes=%llu flags=0x%x writep=%d\n",
