+/*
+ * Some sticks answer ILLEGAL REQUEST (sense key 5, ASC 0x20) to commands they
+ * simply do not implement -- SYNCHRONIZE CACHE (0x35) is the common one on
+ * cheap USB bridges. That is a property of the device, not a transport fault:
+ * retrying it, or running the BOT recovery sequence because of it, only makes
+ * things worse. Remember which opcodes were refused and answer EOPNOTSUPP
+ * without touching the transport from then on.
+ */
+#define USBMSC_UNSUPPORTED_MAX 8
+static uint8_t usbmsc_unsupported[USBMSC_UNSUPPORTED_MAX];
+
+static bool usbmsc_opcode_refused(uint8_t op) {
+ for (unsigned i = 0; i < USBMSC_UNSUPPORTED_MAX; i++) {
+  if (usbmsc_unsupported[i] == op) {
+   return true;
+  }
+ }
+ return false;
+}
+
+static void usbmsc_opcode_mark(uint8_t op) {
+ for (unsigned i = 0; i < USBMSC_UNSUPPORTED_MAX; i++) {
+  if (usbmsc_unsupported[i] == 0) {
+   usbmsc_unsupported[i] = op;
+   printf("usbmsc: opcode 0x%02x not supported by the device, will not retry\n", op);
+   return;
+  }
+ }
+}
