+/*
+ * xHCI keeps its own dequeue position per endpoint. Rebuilding a ring in
+ * memory is not enough: until the controller is told where the ring starts
+ * again (Set TR Dequeue Pointer, TRB type 16) it keeps walking the old
+ * position, which is why the previous recovery left every later transfer
+ * timing out. Parameter is the ring address with the DCS bit set; the status
+ * word carries the endpoint ID.
+ */
+static void usbmsc_set_dequeue(uint32_t dci,uint32_t ring_off) {
+ uint64_t p=phys(ring_off)|1u;
+ command(16,p,dci<<16,NULL);
+}
