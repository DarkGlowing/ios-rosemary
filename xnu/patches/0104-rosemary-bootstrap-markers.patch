diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
index bec97fb..205c483 100644
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -376,6 +376,19 @@ kernel_startup_log(startup_subsystem_id_t subsystem)
 	}
 
 	if (subsystem < sizeof(names) / sizeof(names[0]) && names[subsystem]) {
+#if defined(ARM64_BOARD_CONFIG_ROSEMARY)
+		/* One line per subsystem: the boot dies in one of them and prints no
+		 * panic. rosemaryphase=0 turns it off. */
+		static int rosemary_phase = -1;
+		if (rosemary_phase < 0) {
+			rosemary_phase = 1;
+			(void)PE_parse_boot_argn("rosemaryphase", &rosemary_phase,
+			    sizeof(rosemary_phase));
+		}
+		if (rosemary_phase) {
+			kprintf("ROSEMARY PHASE: %s\n", names[subsystem]);
+		}
+#endif
 		kernel_bootstrap_log(names[subsystem]);
 	}
 	logged = subsystem;
@@ -419,6 +432,12 @@ kernel_startup_initialize_upto(startup_subsystem_id_t upto)
 	startup_phase = upto;
 }
 
+#if defined(ARM64_BOARD_CONFIG_ROSEMARY)
+#define ROSEMARY_BOOT_MARK(x) kprintf("ROSEMARY BOOT: %s\n", x)
+#else
+#define ROSEMARY_BOOT_MARK(x) do { } while (0)
+#endif
+
 void
 kernel_bootstrap(void)
 {
@@ -690,29 +709,37 @@ kernel_bootstrap_thread(void)
 #endif
 
 	assert(ml_get_interrupts_enabled() == FALSE);
+	ROSEMARY_BOOT_MARK("iokit matching done, interrupts off");
 
 	/*
 	 * Past this point, kernel subsystems that expect to operate with
 	 * interrupts or preemption enabled may begin enforcement.
 	 */
+	ROSEMARY_BOOT_MARK("early_boot phase start");
 	kernel_startup_initialize_upto(STARTUP_SUB_EARLY_BOOT);
+	ROSEMARY_BOOT_MARK("early_boot phase done");
 
 #if SCHED_HYGIENE_DEBUG
 	// Reset interrupts masked timeout before we enable interrupts
 	ml_spin_debug_clear_self();
 #endif
 	(void) spllo();         /* Allow interruptions */
+	ROSEMARY_BOOT_MARK("interrupts enabled");
 
 	/*
 	 * This will start displaying progress to the user, start as early as possible
 	 */
+	ROSEMARY_BOOT_MARK("acquiring screen");
 	initialize_screen(NULL, kPEAcquireScreen);
+	ROSEMARY_BOOT_MARK("screen acquired");
 
 	/*
 	 *	Initialize the shared region module.
 	 */
+	ROSEMARY_BOOT_MARK("commpage init start");
 	vm_commpage_init();
 	vm_commpage_text_init();
+	ROSEMARY_BOOT_MARK("commpage init done");
 
 #if CONFIG_MACF
 	kernel_bootstrap_log("mac_policy_initmach");
@@ -744,7 +771,9 @@ kernel_bootstrap_thread(void)
 	load_static_trust_cache();
 #endif
 
+	ROSEMARY_BOOT_MARK("lockdown phase start");
 	kernel_startup_initialize_upto(STARTUP_SUB_LOCKDOWN);
+	ROSEMARY_BOOT_MARK("lockdown phase done");
 
 	/*
 	 * Get rid of segments used to bootstrap kext loading. This removes
@@ -757,7 +786,9 @@ kernel_bootstrap_thread(void)
 
 	/* No changes to kernel text and rodata beyond this point. */
 	kernel_bootstrap_log("machine_lockdown");
+	ROSEMARY_BOOT_MARK("machine_lockdown start");
 	machine_lockdown();
+	ROSEMARY_BOOT_MARK("machine_lockdown done");
 
 #ifdef CONFIG_XNUPOST
 	kern_return_t result = kernel_list_tests();
@@ -787,7 +818,9 @@ kernel_bootstrap_thread(void)
 	 *	Start the user bootstrap.
 	 */
 #ifdef  MACH_BSD
+	ROSEMARY_BOOT_MARK("calling bsd_init");
 	bsd_init();
+	ROSEMARY_BOOT_MARK("bsd_init returned");
 #endif
 
 
