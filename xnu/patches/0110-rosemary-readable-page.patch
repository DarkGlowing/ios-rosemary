 	for (;;) {
 		(void)tsleep(&rosemary_beat_chan, PZERO, "rosemarybt",
 		    hz * (int)rosemary_beat_secs);
@@ -170,6 +171,22 @@
 			until_page--;
 			continue;
 		}
+		/*
+		 * Stop once the log stops growing: paging a dead log replaces a
+		 * readable screen with the same page. rosemarypagehold stale pages
+		 * and the pager leaves the last page up.
+		 */
+		static uint32_t rosemary_last_seen;
+		static uint32_t rosemary_stale_pages;
+		if (log_total == rosemary_last_seen) {
+			if (++rosemary_stale_pages >= rosemary_page_hold) {
+				continue;
+			}
+		} else {
+			rosemary_stale_pages = 0;
+		}
+		rosemary_last_seen = log_total;
+
 		/* Page the log, then give the reader time to photograph it. */
 		page_no++;
 		printf("ROSEMARY LOGPAGE: page %u\n", page_no);
@@ -190,6 +207,10 @@
 	(void)PE_parse_boot_argn("rosemarypage", &rosemary_page_from, sizeof(rosemary_page_from));
 	(void)PE_parse_boot_argn("rosemarypageevery", &rosemary_page_every, sizeof(rosemary_page_every));
 	(void)PE_parse_boot_argn("rosemarypageback", &rosemary_page_back, sizeof(rosemary_page_back));
+	(void)PE_parse_boot_argn("rosemarypagehold", &rosemary_page_hold, sizeof(rosemary_page_hold));
+	if (rosemary_page_hold > 60) {
+		rosemary_page_hold = 60;
+	}
 	if (rosemary_page_every == 0) {
 		printf("ROSEMARY BEAT: log paging disabled\n");
 	}
