From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rosemary port <port@local>
Date: Mon, 2 Nov 2026 18:15:00 +0500
Subject: [PATCH] arm64/start: map the second 32MB block of the splash framebuffer

0010 maps one L2 block at 0x7a000000, but the panel is 1088x4800x4 = 20.9MB
starting at 0x7bd20000, so only 2.87MB of it was mapped before arm_vm_init
installs the real alias -- about 21 text rows at 2x scale. Anything longer ran
off the end of the block and died half drawn, which is exactly what the
full-screen panic dump did. Map the 0x7c000000 block as well.
---
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index fc0c6ab..b4902eb 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -643,6 +643,19 @@ Lkernelcache_base_found:
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+
+	/*
+	 * ...and the next 32MB block. The panel is 1088x4800x4 = 20.9MB starting
+	 * at 0x7bd20000, so the block above only covers the first 2.87MB of it --
+	 * about 21 text rows, which is why a full-screen panic dump used to die
+	 * half drawn. Both blocks live in the same V=P L2 table (16K pages).
+	 */
+	MOV64	x10, 0x7c000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
 #endif
 
 	/* Ensure TTEs are visible */
