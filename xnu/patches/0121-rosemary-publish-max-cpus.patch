--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -816,6 +816,17 @@
 	 * max_cpus must be nailed down by the time PE_lockdown_iokit() finishes,
 	 * at the latest
 	 */
+	/*
+	 * Publish max_cpus before BSD starts. ml_wait_max_cpus() sleeps until
+	 * ml_set_max_cpus() has run, and the only caller is
+	 * RosemaryCPU::start(), whose IONameMatch is 'qcom,kryo470' -- a
+	 * Qualcomm node that does not exist in this MediaTek device tree.
+	 * Without this, mcache_init() in bsd_init sleeps forever, which is
+	 * exactly where the boot stopped (last line: "calling
+	 * proc_uuid_policy_init()").
+	 */
+	ml_set_max_cpus(machine_info.max_cpus);
+
 	ROSEMARY_BOOT_MARK("vm_set_restrictions start");
 	vm_set_restrictions(machine_info.max_cpus);
 	ROSEMARY_BOOT_MARK("vm_set_restrictions done");
