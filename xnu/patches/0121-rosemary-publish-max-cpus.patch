--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -391,6 +391,18 @@
 	extern void rosemary_wdt_map(void);
 	rosemary_wdt_map();
 	rosemary_beat_start();
+	/*
+	 * Publish max_cpus now. ml_wait_max_cpus() sleeps until
+	 * ml_set_max_cpus() has run, and the only caller is RosemaryCPU::start(),
