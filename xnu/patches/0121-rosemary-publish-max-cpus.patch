--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -6,6 +6,8 @@
 #include <sys/types.h>
 #include <sys/kdebug.h>
 #include <mach/vm_param.h>
+/* struct machine_info lives here; ml_set_max_cpus needs max_cpus */
+#include <mach/machine.h>
 #include <pexpert/protos.h>
 #include <pexpert/pexpert.h>
 #include <pexpert/boot.h>
@@ -402,6 +404,16 @@
 		extern void rosemary_ufs_log_only(void);
 		rosemary_ufs_log_only();
 	}
+	/*
+	 * Publish max_cpus now. ml_wait_max_cpus() sleeps until
+	 * ml_set_max_cpus() has run, and the only caller is
+	 * RosemaryCPU::start(), whose IONameMatch is 'qcom,kryo470' -- a
+	 * Qualcomm node that does not exist in this MediaTek device tree.
+	 * Without this, mcache_init() in bsd_init sleeps forever, which is
+	 * exactly where the boot stopped (last line: "calling
+	 * proc_uuid_policy_init()").
+	 */
+	ml_set_max_cpus(machine_info.max_cpus);
 #endif
 	StartIOKitMatching();
 }
