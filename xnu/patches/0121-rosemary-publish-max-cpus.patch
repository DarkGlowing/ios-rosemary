+	 * exist in this MediaTek device tree. Without this, mcache_init() in
+	 * bsd_init sleeps forever, which is exactly where the boot stopped
+	 * (last line: "calling proc_uuid_policy_init()").
+	 */
+	{
+		extern void ml_set_max_cpus(unsigned int max_cpus);
+		ml_set_max_cpus(machine_info.max_cpus);
+	}
 #endif
 	StartIOKitMatching();
 }
