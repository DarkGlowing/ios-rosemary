- */
-int rosemary_console_muted;
-#endif
-
 static inline void
 _cnputs(char *c, int size, bool poll)
 {
 	extern int disableConsoleOutput;
 
 #if defined(ARM64_BOARD_CONFIG_ROSEMARY)
-	rosemary_log_append(c, size);
