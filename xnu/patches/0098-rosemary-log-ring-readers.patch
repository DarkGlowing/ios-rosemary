diff --git a/bsd/dev/rosemary_ufs.c b/bsd/dev/rosemary_ufs.c
index 62889e1..bbd2550 100644
--- a/bsd/dev/rosemary_ufs.c
+++ b/bsd/dev/rosemary_ufs.c
@@ -681,6 +681,13 @@ rosemary_ufs_init(void)
 static char rosemary_log_ring[ROSEMARY_LOG_SIZE];
 static uint64_t _Atomic rosemary_log_total;
 static int rosemary_log_chan;
+/*
+ * Set while the pager prints a page: the page comes out of this ring, so
+ * recording it again would push the log it is showing out of the window and
+ * the pager would end up displaying itself. bsd/dev/rosemary_beat.c
+ */
+int rosemary_log_pause;
+
 static uint32_t rosemary_log_secs = ROSEMARY_LOG_SECS;
 
 /* Called for all console output, any context: never blocks. */
@@ -689,7 +696,7 @@ void rosemary_log_append(const char *c, int size);
 void
 rosemary_log_append(const char *c, int size)
 {
-	if (size <= 0) {
+	if (size <= 0 || rosemary_log_pause) {
 		return;
 	}
 	uint64_t at = os_atomic_add_orig(&rosemary_log_total, (uint64_t)size, relaxed);
@@ -788,4 +795,38 @@ rosemary_ufs_rootdev(dev_t *dev)
 	*dev = su.bdev;
 	return 0;
 }
+/*
+ * Read side of the ring, for the boot-log pager (bsd/dev/rosemary_beat.c).
+ *
+ * The pager runs on another CPU while the bootstrap thread may be stuck in
+ * the middle of a console write, so neither function takes a lock: a byte is
+ * a byte, and a torn line at the wrap point only costs one line of the dump.
+ */
+uint64_t rosemary_bootlog_position(void);
+uint32_t rosemary_bootlog_copy(uint64_t *pos, char *out, uint32_t max);
+
+uint64_t
+rosemary_bootlog_position(void)
+{
+	return os_atomic_load(&rosemary_log_total, relaxed);
+}
+
+uint32_t
+rosemary_bootlog_copy(uint64_t *pos, char *out, uint32_t max)
+{
+	uint64_t total = os_atomic_load(&rosemary_log_total, relaxed);
+
+	/* A reader that fell further behind than the ring is long skips ahead. */
+	if (total - *pos > ROSEMARY_LOG_SIZE) {
+		*pos = total - ROSEMARY_LOG_SIZE;
+	}
+	uint32_t n = (uint32_t)MIN((uint64_t)max, total - *pos);
+
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = rosemary_log_ring[(*pos + i) % ROSEMARY_LOG_SIZE];
+	}
+	*pos += n;
+	return n;
+}
+
 #endif /* ARM64_BOARD_CONFIG_ROSEMARY */
