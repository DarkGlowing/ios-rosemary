From: Chatbox <chatbox@chatboxai.com>
Subject: [PATCH] rosemary: pet the watchdog from the log thread

--- a/bsd/dev/rosemary_ufs.c
+++ b/bsd/dev/rosemary_ufs.c
@@ -50,6 +50,10 @@
 extern int hz;
 static void rosemary_log_start(void);
 void rosemary_ufs_log_only(void);
+/* Defined at the bottom of this file. The log thread pets the watchdog
+ * too: console output used to do it through _cnputc, but a silent hang
+ * stops that as well. */
+void rosemary_wdt_pet(void);
 extern void rosemary_sample_start(void);
 extern void rosemary_keys_init(void);
 extern void rosemary_touch_init(void);
@@ -776,6 +780,12 @@
 	    ROSEMARY_LOG_BLOCKS * UFS_BLOCK >> 10, base);
 	for (;;) {
 		(void)tsleep(&rosemary_log_chan, PZERO, "rosemarylog", hz * (int)rosemary_log_secs);
+		/*
+		 * Pet here as well. Petting lived only in the beat thread, so once
+		 * the boot thread stopped printing, nothing petted and the watchdog
+		 * fired about 30 s later: the phone rebooted and the ring was lost.
+		 */
+		rosemary_wdt_pet();
 		uint64_t total = os_atomic_load(&rosemary_log_total, relaxed);
 		if (total == flushed) {
 			continue;
