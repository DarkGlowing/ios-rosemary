+void wdt_disable(void)
+{
+	/* WDT_MODE bit0 = WDT_EN (1 = running). Clear it with the same key
+	 * that protects WDT_LENGTH/WDT_RESTART. Best-effort: if the preloader
+	 * uses a different WDT instance this write is harmless. */
+	wr32(A7_WDT_BASE + WDT_MODE, (WDT_KEY << 16) | 0x0000u);
+	dsb();
+}
