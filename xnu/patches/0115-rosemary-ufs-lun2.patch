+/*
+ * Print what the first block of the partition actually holds. The
+ * HFS+ volume header is big endian at 0x400 (sig 0x482b for HFS+,
+ * 0x4858 for case-sensitive HX); ext4 keeps its magic at 0x438;
+ * all zeroes means the wrong LUN or a read that never landed.
+ */
+static void
+ufs_dump_head(void)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	if (ufs_read_blocks(su.first_block, 1)) {
+		printf("ROSEMARY UFS: head read failed\n");
+		return;
+	}
+	uint32_t nz = 0;
+	for (uint32_t i = 0; i < UFS_BLOCK; i++) {
+		nz += (b[i] != 0);
+	}
+	printf("ROSEMARY UFS: block0 nonzero %u of %u, ext4 magic@0x438 %02x%02x\n",
+	    nz, UFS_BLOCK, b[0x438], b[0x439]);
+	const uint32_t *w = (const uint32_t *)(b + 0x400);
+	printf("ROSEMARY UFS: vh@0x400 %08x %08x %08x %08x\n",
+	    w[0], w[1], w[2], w[3]);
+	printf("ROSEMARY UFS: vh@0x410 %08x %08x %08x %08x\n",
+	    w[4], w[5], w[6], w[7]);
+	printf("ROSEMARY UFS: vh@0x420 %08x %08x %08x %08x\n",
+	    w[8], w[9], w[10], w[11]);
+	printf("ROSEMARY UFS: vh@0x430 %08x %08x %08x %08x\n",
+	    w[12], w[13], w[14], w[15]);
+	printf("ROSEMARY UFS: HFS+ sig 482b, HX 4858, ext4 53ef\n");
+}
