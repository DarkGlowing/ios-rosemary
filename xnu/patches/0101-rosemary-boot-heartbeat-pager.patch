diff --git a/bsd/dev/rosemary_beat.c b/bsd/dev/rosemary_beat.c
new file mode 100644
index 0000000..4dce893
--- /dev/null
+++ b/bsd/dev/rosemary_beat.c
@@ -0,0 +1,206 @@
+/*
+ * ROSEMARY boot heartbeat and boot-log pager.
+ *
+ * The phone has no usable serial port, no ADB while XNU runs, and the log a
+ * previous boot leaves in DRAM does not survive the reset to Android. The
+ * only output channel that always exists is the panel, and it shows 67x74
+ * characters, so a boot that stops leaves at most the last screen.
+ *
+ * This thread answers the two questions that matter when the boot stops:
+ *
+ *   - is the kernel alive? Every second it prints one character ("." and a
+ *     "ROSEMARY BEAT n" line every 15 s). If the dots continue after the last
+ *     driver message, the machine is alive and only the bootstrap thread is
+ *     stuck; if they stop, the CPU is spinning with interrupts off or the
+ *     console itself died.
+ *
+ *   - what did it print? The full console ring (bsd/dev/rosemary_ufs.c,
+ *     fed from _cnputs, 4 MiB) is paged to the screen after the boot is
+ *     clearly stuck: 60 lines per page, the last page first, then backwards
+ *     to the oldest byte, then round again, so every page can be photographed
+ *     and read offline.
+ *
+ * Boot args: rosemarybeat=SECS (tick, default 1), rosemarypage=SECS (first
+ * page after this many seconds, default 40), rosemarypageevery=SECS
+ * (default 20). rosemarypage=0 disables paging.
+ */
+#if defined(ARM64_BOARD_CONFIG_ROSEMARY)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+
+/* Not exported to the BSD layer by the headers above. */
+extern int hz;
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+
+/* bsd/dev/rosemary_ufs.c */
+#define ROSEMARY_LOG_RING       (4u << 20)
+extern uint64_t rosemary_bootlog_position(void);
+extern uint32_t rosemary_bootlog_copy(uint64_t *pos, char *out, uint32_t max);
+/* bsd/dev/rosemary_ufs.c: MTK top RGU, also petted from the console path */
+extern void rosemary_wdt_pet(void);
+/* osfmk/console/serial_console.c: set by AppleCLCD when the GUI takes over */
+extern int rosemary_console_muted;
+/* bsd/dev/rosemary_ufs.c: set while a page is printed, so the pager does not
+ * record its own output into the ring it is reading from. */
+extern int rosemary_log_pause;
+
+void rosemary_beat_start(void);
+
+static uint32_t rosemary_beat_secs = 1;
+static uint32_t rosemary_beat_line = 15;        /* full line every N ticks */
+static uint32_t rosemary_page_from = 8;         /* first page, seconds */
+static uint32_t rosemary_page_every = 6;        /* next pages, seconds */
+static uint32_t rosemary_page_bytes = 3000;     /* ~50 lines of 80 chars */
+static int rosemary_page_back;                   /* walk backwards instead of tail */
+static int rosemary_beat_chan;
+
+static uint32_t rosemary_beat_count;
+static uint64_t rosemary_page_end;              /* ring position after the last page */
+
+/*
+ * Print one page of the console ring.
+ *
+ * Default mode is a rolling tail: every page shows the last page_bytes of the
+ * log as it is *now*. That is the only useful mode for a boot that dies - the
+ * page on screen at the moment of death is the end of the log. rosemarypageback=1
+ * walks backwards from the tail instead, for reading a long log from a machine
+ * that stays alive.
+ */
+static void
+rosemary_page(void)
+{
+	static char pg[8192];
+	uint64_t log_total = rosemary_bootlog_position();
+	uint64_t log_oldest = log_total > ROSEMARY_LOG_RING ? log_total - ROSEMARY_LOG_RING : 0;
+	uint64_t page_end_pos;
+
+	if (log_total == 0) {
+		return;
+	}
+	if (rosemary_page_back) {
+		if (rosemary_page_end == 0 || rosemary_page_end > log_total) {
+			rosemary_page_end = log_total;
+		}
+		if (rosemary_page_end <= log_oldest) {
+			/* A whole pass is done: start again from the tail. */
+			rosemary_page_end = log_total;
+		}
+		page_end_pos = rosemary_page_end;
+	} else {
+		page_end_pos = log_total;
+	}
+
+	if (rosemary_page_bytes + 64 > sizeof(pg)) {
+		rosemary_page_bytes = (uint32_t)(sizeof(pg) - 64);
+	}
+
+	uint64_t page_begin = page_end_pos > rosemary_page_bytes ?
+	    page_end_pos - rosemary_page_bytes : 0;
+	if (page_begin < log_oldest) {
+		page_begin = log_oldest;
+	}
+
+	uint64_t pos = page_begin;
+	uint32_t n = 0;
+
+	while (n + 1 < sizeof(pg)) {
+		uint32_t k = rosemary_bootlog_copy(&pos, pg + n,
+		    (uint32_t)(sizeof(pg) - 1 - n));
+		if (k == 0) {
+			break;
+		}
+		n += k;
+	}
+	pg[n] = 0;
+
+	/* A page must start and end on a line boundary to be readable. */
+	rosemary_log_pause = 1;
+	printf("\nROSEMARY LOGPAGE: bytes %llu..%llu of %llu\n", page_begin, pos, log_total);
+	printf("%s", pg);
+	printf("\nROSEMARY LOGPAGE: end (bytes %llu..%llu)\n", page_begin, pos);
+	rosemary_log_pause = 0;
+	if (rosemary_page_back) {
+		rosemary_page_end = page_begin;
+	}
+}
+
+static void
+rosemary_beat_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t until_page = rosemary_page_from;
+	uint32_t page_no = 0;
+	uint64_t last_total = rosemary_bootlog_position();
+
+	printf("ROSEMARY BEAT: start (tick %us, first page after %us, then every %us)\n",
+	    rosemary_beat_secs, rosemary_page_from, rosemary_page_every);
+	for (;;) {
+		(void)tsleep(&rosemary_beat_chan, PZERO, "rosemarybt",
+		    hz * (int)rosemary_beat_secs);
+		rosemary_beat_count++;
+		/* Console output feeds the watchdog too, but a silent hang does not. */
+		rosemary_wdt_pet();
+
+		/*
+		 * Never interleave with the boot's own output: writing a dot from
+		 * this thread while the bootstrap thread is in the middle of a
+		 * kprintf drops characters from both (the first run lost the start
+		 * of a console line this way). A dot is printed only when the
+		 * console has been silent for a whole tick, which is exactly the
+		 * question dots exist to answer.
+		 */
+		uint64_t log_total = rosemary_bootlog_position();
+		if (log_total == last_total) {
+			if ((rosemary_beat_count % rosemary_beat_line) == 0) {
+				printf("ROSEMARY BEAT %u\n", rosemary_beat_count);
+			} else {
+				printf(".");
+			}
+		}
+		last_total = log_total;
+
+		if (rosemary_page_every == 0) {
+			continue;
+		}
+		if (until_page > 0) {
+			until_page--;
+			continue;
+		}
+		/* Page the log, then give the reader time to photograph it. */
+		page_no++;
+		printf("ROSEMARY LOGPAGE: page %u\n", page_no);
+		rosemary_page();
+		until_page = rosemary_page_every;
+	}
+}
+
+void
+rosemary_beat_start(void)
+{
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("rosemarybeat", &rosemary_beat_secs, sizeof(rosemary_beat_secs));
+	if (rosemary_beat_secs == 0 || rosemary_beat_secs > 60) {
+		rosemary_beat_secs = 1;
+	}
+	(void)PE_parse_boot_argn("rosemarypage", &rosemary_page_from, sizeof(rosemary_page_from));
+	(void)PE_parse_boot_argn("rosemarypageevery", &rosemary_page_every, sizeof(rosemary_page_every));
+	(void)PE_parse_boot_argn("rosemarypageback", &rosemary_page_back, sizeof(rosemary_page_back));
+	if (rosemary_page_every == 0) {
+		printf("ROSEMARY BEAT: log paging disabled\n");
+	}
+
+	/* Paging must be visible even when AppleCLCD muted the console for the GUI. */
+	rosemary_console_muted = 0;
+
+	if (kernel_thread_start(rosemary_beat_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("ROSEMARY BEAT: thread start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_ROSEMARY */
diff --git a/pexpert/arm/pe_init.c b/pexpert/arm/pe_init.c
index 04dda53..d39e089 100644
--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -379,6 +379,19 @@ PE_lockdown_iokit(void)
 	 * hardware protections.
 	 */
 	zalloc_iokit_lockdown();
+#if defined(ARM64_BOARD_CONFIG_ROSEMARY)
+	/*
+	 * The heartbeat comes up before IOKit matching, which is where the boot
+	 * stops today (the last console line is AppleKeyStore registering).
+	 * From here on a thread prints a dot every second and pages the console
+	 * ring to the panel once the boot is clearly stuck, so a hang is visible
+	 * without a serial port. bsd/dev/rosemary_beat.c
+	 */
+	extern void rosemary_beat_start(void);
+	extern void rosemary_wdt_map(void);
+	rosemary_wdt_map();
+	rosemary_beat_start();
+#endif
 	StartIOKitMatching();
 }
 
